{% extends 'base.html.twig' %}

{% block title %}Commande reçue{% endblock %}

{% block body %}
<div class="order-pending-container" style="max-width:480px;margin:80px auto;text-align:center;">
    <div style="font-size:48px;margin-bottom:16px;">✓</div>

    <h1>Merci pour votre commande !</h1>

    <p>
        Votre paiement a bien été reçu par notre prestataire. Votre commande
        est en cours de finalisation.
    </p>

    <p>
        Vous recevrez un <strong>email de confirmation</strong> dans les
        prochaines minutes avec le récapitulatif de votre commande.
    </p>

    <p style="margin-top:32px;">
        <a href="{{ path('app_home') }}" style="color:#6c3ce9;text-decoration:underline;">
            Retour à l'accueil
        </a>
    </p>
</div>
{% endblock %}