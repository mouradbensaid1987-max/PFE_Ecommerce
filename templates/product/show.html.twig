{% extends 'base.html.twig' %}


{% block title %}{{ product.name }}{% endblock %}


{% block body %}
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"> <a href="{{ path('app_home') }}"><i class="bi bi-house-door" aria-hidden="true"></i> Accueil </a> </li>
        <li class="breadcrumb-item"> <a href="{{ path('app_product_list') }}"> Produits </a> </li>
        <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
      </ol>
    </nav>

  <div class="row g-5">
    <div class="col-md-6">
    {% if product.productImages|length > 0 %}

            {# Carousel principal #}
            <div id="productCarousel" class="carousel slide flex-grow-1" data-bs-ride="false">
                <div class="carousel-inner">
                    {% for productImage in product.productImages %}
                        <div class="carousel-item {% if loop.first %}active{% endif %}">
                            <img src="{{ vich_uploader_asset(productImage, 'imageFile') }}"
                                 class="d-block w-100 rounded"
                                 alt="{{ product.name }}">
                        </div>
                    {% endfor %}
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>


            {# Miniatures horizontal #}
            
            <div class="mt-2">
                {% for productImage in product.productImages %}
                    <button type="button"
                            class="product-thumbnail-btn me-2 m-2 p-0 border-0 bg-transparent"
                            data-bs-target="#productCarousel"
                            data-bs-slide-to="{{ loop.index0 }}"
                            aria-label="Voir la photo {{ loop.index }} sur {{ product.productImages|length }} de {{product.name }}">
                            <img src="{{ vich_uploader_asset(productImage, 'imageFile') }}" alt="" class="product-thumbnail">
                    </button>
                {% endfor %}
            </div>
          


        {% else %}
            <img src="https://placehold.co/600x400/1e4a8a/fff?text={{ product.name|url_encode }}"
                alt="{{ product.name }}" class="img-fluid rounded">
        {% endif %}
    </div>


    <div class="col-md-6">
      <h1>{{ product.name }}</h1>
      <p class="text-muted">Reference : {{ product.ref }}</p>
      <p class="text-muted">Catégorie : {{ product.category.name }}</p>
      <p class="text-justify">{{ product.description }}</p>
      <h2 class="text-primary">  {{ product.priceTtc|number_format(2, ',', ' ') }} € TTC  </h2>
      <p class="text-muted small">TVA {{ product.tva.rate }}%</p>

       {% if product.materiau or product.diametreMm or product.longueurMm
            or product.typeTete or product.typeEmpreinte or product.unite
            or product.quantiteConditionnement %}
          <h6 class="mt-3">Caractéristiques techniques</h6>
          <table class="table table-sm table-bordered w-auto">
              <tbody>
                  {% if product.materiau %}
                    <tr>
                        <th scope="row">Matériau</th>
                        <td>{{ product.materiau }}</td>
                    </tr>
                  {% endif %}
                  {% if product.diametreMm %}
                    <tr>
                        <th scope="row">Diamètre</th>
                        <td>{{ product.diametreMm }}</td>
                    </tr>
                  {% endif %}
                  {% if product.longueurMm %}
                    <tr>
                        <th scope="row">Longueur</th>
                        <td>{{ product.longueurMm }} mm</td>
                    </tr>
                  {% endif %}
                  {% if product.typeTete %}
                    <tr>
                        <th scope="row">Type de tête</th>
                        <td>{{ product.typeTete }}</td>
                    </tr>
                  {% endif %}
                  {% if product.typeEmpreinte %}
                    <tr>
                        <th scope="row">Empreinte</th>
                        <td>{{ product.typeEmpreinte }}</td>
                    </tr>
                  {% endif %}
                  {% if product.unite %}
                    <tr>
                        <th scope="row">Unité de vente</th>
                        <td>{{ product.unite }}</td>
                    </tr>
                  {% endif %}
                  {% if product.quantiteConditionnement %}
                    <tr>
                        <th scope="row">Conditionnement</th>
                        <td>{{ product.quantiteConditionnement }} pièce(s)</td>
                    </tr>
                  {% endif %}
              </tbody>
          </table>
      {% endif %}

      {% if product.stock is defined %}
          <p class="badge {{ product.stock <= 0 ? 'bg-danger' : (product.stock <= 5 ? 'bg-warning text-dark' : 'bgsuccess-subtle text-success-emphasis') }}">
              {% if product.stock <= 0 %}
                  <i class="bi bi-x-circle" aria-hidden="true"></i> Rupture
              {% elseif product.stock <= 5 %}
                  <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> {{ product.stock }} restant{{ product.stock > 1 ? 's' : '' }}
              {% else %}
                  <i class="bi bi-check-circle" aria-hidden="true"></i> En stock({{ product.stock }})
              {% endif %}
          </p>
      {% endif %}

  
      <div class="d-flex gap-2">
          <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}" class="flex-grow-1">
              <button class="btn btn-primary btn-lg w-100"
                {% if product.stock <= 0 %} disabled {% endif %}>
                <span aria-hidden="true">🛒</span> Ajouter au panier
              </button>
          </form>
          {% if app.user %}
              {% set isFavorite = product.id in favoriteIds %}
              <form method="post" action="{{ path('app_favorite_toggle', {id: product.id}) }}">
                  <button class="btn btn-outline-danger btn-lg" 
                          aria-label="{{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                          title= " {{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">  
                      <i class="bi {{ isFavorite ? 'bi-heart-fill' : 'bi-heart' }}" aria-hidden="true" ></i>
                  </button>
              </form>
          {% endif %}
      </div>

    </div>
  </div>

{% endblock %}