{% extends 'base.html.twig' %}

{% block title %}Mes favoris{% endblock %}

{% block body %}

<h1>❤️ Mes favoris</h1>
  <br>

    {% if favorites|length == 0 %}

        <div class="alert alert-info mt-3">
              Aucun favori. Cliquez sur le ❤️ sur une page produit pour en ajouter.
        </div>

    {% else %}

          <div class="version-sm-plus">
                  <div class="row g-3">
                      {% for fav in favorites %}
                            <div class="col-sm-6 col-lg-3 col-md-4">
                                {% include 'components/_product_card.html.twig' with {product: fav.product} %}
                            </div>
                      {% endfor %}
                  </div>
          </div>
          <div class="version-mobile">
                <div class="row g-3">
                      {% for fav in favorites %}
                        {% include 'components/_product_card_smull.html.twig' with {product: fav.product} %}
                      {% endfor %}
                </div>
          </div>




    {% endif %}


{% endblock %}