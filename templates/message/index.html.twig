{% extends 'base.html.twig' %}

{% block title %}Mes messages{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center">
        <h1><span aria-hidden="true">✉️</span> Mes messages</h1>
          {% if is_granted('ROLE_ADMIN') %}
                  
            {% else %}
                <a href="{{ path('app_message_new') }}" class="btn btn-primary">Nouveau message</a>
            {% endif %}
        
    </div>

    {% for m in messages %}
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between">
                <strong>{{ m.subject }}</strong>
                {% if m.status == 'answered' %}
                    <span class="badge text-dark bg-success">Répondu</span>
                {% else %}
                    <span class="badge text-dark bg-warning">En attente</span>
                {% endif %}
            </div>

            <div class="card-body">
                <p>{{ m.content }}</p>
                {% if m.reply %}
                    <hr>
                    <p class="text-primary"><strong>Réponse de l'admin :</strong> {{ m.reply }}</p>
                {% endif %}
            </div>
        </div>
            {% else %}
              <p class="mt-3">Vous n'avez envoyé aucun message.</p>
    {% endfor %}

{% endblock %}