{% extends 'base.html.twig' %}

{% block title %}Mes adresses{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="bi bi-geo-alt-fill text-danger me-2" aria-hidden="true"></i> Mes adresses</h1>
        <a href="{{ path('app_address_new') }}" class="btn btn-primary pb-2 pe-3"> <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Ajouter</a>
    </div>

    {% if addresses|length == 0 %}
        <div class="alert alert-info">Aucune adresse enregistrée.</div>
    {% else %}

      <div class="row g-3">
          {% for address in addresses %}
            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-body">
                    
                    <h2 class="h6 mb-1">{{ address.firstName }} {{ address.lastName }}</h2>
                    <p class="mb-1 text-muted small">
                        {{ address.street }}<br>
                        {{ address.postalCode }} {{ address.city }}<br>
                        {{ address.country }}
                        {% if address.phone %}
                            <br><i class="bi bi-telephone-fill text-primary me-2" aria-hidden="true"></i> {{ address.phone }}
                        {% endif %}
                    </p>
                </div>
                <div class="card-footer d-flex gap-2">

                    <a href="{{ path('app_address_edit', {id: address.id}) }}" 
                       class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-fill text-danger me-2" aria-hidden="true"></i> Modifier</a>
                       <span aria-hidden="true"></span>

                    <form method="post" 
                          action="{{ path('app_address_delete', {id:address.id}) }}"
                          onsubmit="return confirm('Supprimer cette adresse ?');">

                      <input type="hidden" 
                             name="_token"
                             value="{{ csrf_token('delete' ~ address.id) }}">
                      <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash-fill text-danger me-2" aria-hidden="true"></i> Supprimer</button>

                    </form>
                </div>
              </div>
            </div>
          {% endfor %}
      </div>
    {% endif %}
{% endblock %}