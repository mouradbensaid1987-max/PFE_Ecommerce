{% extends 'admin/base.html.twig' %}

{% block admin_body %}

    <h1><span aria-hidden="true">👥</span> Utilisateurs</h1>
    <table class="table mt-3">
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Email</th>
                <th scope="col">Nom</th>
                <th scope="col">Rôles</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            {% for u in users %}
                <tr>
                    <td>{{ u.id }}</td>
                    <td>{{ u.email }}</td>
                    <td>{{ u.firstName }} {{ u.lastName }}</td>
                    <td>
                        {% if 'ROLE_ADMIN' in u.roles %}
                            <span class="badge bg-danger">Admin</span>
                        {% else %}
                            <span class="badge bg-secondary">Client</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" 
                           class="btn btn-sm btn-outline-primary" aria-label="Modifier le client {{ u.firstName}}"><span aria-hidden="true">✏️</span></a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}