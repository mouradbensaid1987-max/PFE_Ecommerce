{% extends 'admin/base.html.twig' %}


{% block admin_body %}

<h1>{{ title }}</h1>
<div class="card mt-3">
    <div class="card-body">

        {{ form_start(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}

            <button type="submit" class="btn btn-primary"><i class="bi bi-floppy-fill text-danger me-1" aria-hidden="true"></i> Enregistrer</button>
            <a href="{{ path('app_admin_category_index') }}" class="btn btn-secondary">Annuler</a>

        {{ form_end(form) }}
    </div>
</div>


{% endblock %}