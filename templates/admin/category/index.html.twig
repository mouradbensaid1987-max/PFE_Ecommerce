{% extends 'admin/base.html.twig' %}

{% block admin_body %}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-folder2-open text-primary me-2" aria-hidden="true"></i> Catégories</h1>
    <a href="{{ path('app_admin_category_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>  Nouvelle</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Nom</th>
            <th scope="col">Slug</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        {% for cat in categories %}
          <tr>
            
            <td>{{ cat.name }}</td>
            <td>{{ cat.slug }}</td>
            <td class="text-end">
                <a href="{{ path('app_admin_category_edit', {id: cat.id}) }}" 
                   class="btn btn-sm btn-outline-primary" 
                   aria-label="Modifier la catégorie {{ cat.name}}"><i class="bi bi-pencil-fill text-danger" aria-hidden="true"></i></a>
                
                {% if cat.products.isEmpty %}
                    <form method="post" action="{{ path('app_admin_category_delete', {id: cat.id}) }}" class="d-inline" id="deleteForm{{ cat.id }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cat.id) }}">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal{{ cat.id }}"
                                aria-label="Supprimer la catégorie {{ cat.name }}">
                            <i class="bi bi-trash-fill" aria-hidden="true"></i>
                        </button>
                    </form>
                {% else %}
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                disabled
                                title="{{ cat.products.count }} produit(s) rattaché(s) — suppression impossible"
                                aria-label="Suppression impossible : {{ cat.products.count }} produit(s) rattaché(s) à {{ cat.name }}">
                            <i class="bi bi-trash-fill" aria-hidden="true"></i>
                        </button>
                {% endif %}
            </td>
          </tr>
        {% endfor %}
    </tbody>
</table>

{# Modales de confirmation — regroupées ici, hors du tableau #}
{% for cat in categories %}
    {% if cat.products.isEmpty %}
        <div class="modal fade" id="deleteModal{{ cat.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ cat.id }}" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel{{ cat.id }}">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
              </div>
              <div class="modal-body">
                Voulez-vous vraiment supprimer la catégorie « {{ cat.name }} » ? Cette action est irréversible.
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-danger" form="deleteForm{{ cat.id }}">
                    <i class="bi bi-trash-fill me-1" aria-hidden="true"></i> Supprimer
                </button>
              </div>
            </div>
          </div>
        </div>
    {% endif %}
{% endfor %}


{% endblock %}