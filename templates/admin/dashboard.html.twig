{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block admin_body %}

<h1 class="mb-4"><span aria-hidden="true">📊</span> Tableau de bord</h1>

<div class="row g-3">

        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h2 class="h6 card-title">Produits</h2>
                    <p class="fs-2 fw-bold mb-0">{{ nbProducts }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h2 class="h6 card-title">Catégories</h2>
                    <p class="fs-2 fw-bold mb-0">{{ nbCategories }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h2 class="h6 card-title">Utilisateurs</h2>
                    <p class="fs-2 fw-bold mb-0">{{ nbUsers }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h2 class="h6 card-title">Commandes</h2>
                    <p class="fs-2 fw-bold mb-0">{{ nbOrders }}</p>
                </div>
            </div>
        </div>

</div>

{% endblock %}