{% extends 'admin/base.html.twig' %}

{% block admin_body %}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><span aria-hidden="true">📦</span> Produits</h1>
    <a href="{{ path('app_admin_product_new') }}" class="btn btn-primary"><span aria-hidden="true">➕</span> Nouveau</a>
</div>

<form method="get" action="{{ path('app_admin_product_index') }}" class="row g-2 align-items-end mb-3 p-3 border rounded bglight">

      <div class="col-sm-6 col-lg-3">
        <label for="admin-filter-search" class="form-label small">Recherche (nom, référence)</label>
        <input id="admin-filter-search" type="search" name="q" class="form-control" value="{{ filters.search }}">
      </div>

      <div class="col-sm-6 col-lg-3">
        <label for="filter-category" class="form-label small">Catégorie</label>
        <select id="filter-category" name="category" class="form-select">
          <option value="">Toutes</option>
              {% for cat in categories %}
                <option value="{{ cat.id }}" {{ filters.category == cat.id ? 'selected' : '' }}>{{ cat.name }}</option>
              {% endfor %}
        </select>
      </div>

      <div class="col-sm-6 col-lg-2">
        <label for="admin-filter-materiau" class="form-label small">Matériau</label>
        <select id="admin-filter-materiau" name="materiau" class="form-select">
              <option value="">Tous</option>
              {% for m in materiaux %}
                <option value="{{ m }}" {{ filters.materiau == m ? 'selected' : '' }}>{{ m }}</option>
              {% endfor %}
        </select>
      </div>

      <div class="col-sm-6 col-lg-2">
        <label for="admin-filter-status" class="form-label small">Statut</label>
        <select id="admin-filter-status" name="isActive" class="form-select">
          <option value="">Tous</option>
          <option value="1" {{ filters.isActive == '1' ? 'selected' : '' }}>Actif</option>
          <option value="0" {{ filters.isActive == '0' ? 'selected' : '' }}>Inactif</option>
        </select>
      </div>

      <div class="col-sm-3 col-lg-2">
          <button class="btn btn-primary" title="Filtrer"><span aria-hidden="true">🔍</span> Filtrer</button>
      </div>

      <div class="col-sm-6 col-lg-12">
        <a href="{{ path('app_admin_product_index') }}" class="btn btn-outline-secondary">↺ Réinitialiser les filtres</a>
      </div>

</form>


  <div class="admin-tablet-up">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">Img</th>
                <th scope="col">Ref</th>
                <th scope="col">Nom</th>
                <th scope="col">Catégorie</th>
                <th scope="col">Prix HT</th>
                <th scope="col">Stock</th>
                <th scope="col">Actif</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
              {% for p in products %}
                  <tr>
                    <td>
                        <div class="admin-product-image">
                            <a href="{{ path('app_product_show',{id:p.id, slug: p.slug|replace({'\'': '-', ' ': '-'})|lower})  }}">
                              {% if p.productImages|length > 0 %}
                                  <img  src="{{ vich_uploader_asset(p.productImages|first, 'imageFile') }}"
                                        class="admin-product-img"  
                                        alt="{{ p.name }}">
                              {% else %}
                                  <div class="placeholder-img"></div>
                              {% endif %}
                            </a>
                        </div>
                    </td>
                    <td>{{ p.ref }}</td>
                    <td>{{ p.name }}</td>
                    <td>
                        {% if p.category %}
                            {{ p.category.name }}
                        {% else %}
                            Non classé
                        {% endif %}
                    </td>
                    <td>{{ p.priceHt }} €</td>
                    <td>{{ p.stock }}</td>
                    <td>
                        {% if p.isActive %}
                          <span class="badge text-bg-success fs-6">Actif </span>
                        {% else %}
                          <span class="badge text-bg-danger fs-6">Inactif </span>
                        {% endif %}
                    </td>
                    <td class="text-end">

                        <a href="{{ path('app_admin_product_edit', {id: p.id}) }}" 
                           class="btn btn-sm btn-outline-primary"
                           aria-label="Modifier le produit {{ p.name }}">
                           <span aria-hidden="true">✏️</span>
                        </a>
                        <form method="post" action="{{ path('app_admin_product_delete', {id:p.id}) }}"
                              class="d-inline" onsubmit="return confirm('Supprimer ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ p.id) }}">
                            <button class="btn btn-sm btn-outline-danger" aria-label="Supprimer le produit {{ p.name }}">
                              <span aria-hidden="true">🗑️</span>
                            </button>
                        </form>
                    </td>
                  </tr>
              {% endfor %}

              
        </tbody>
      </table>
  </div>
  <div class="admin-tablet">
          {% for p in products %}
            
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                  <div class="row">
                            <div class="col-4 text-center">
                                  <a href="{{ path('app_product_show',{id:p.id, slug: p.slug|replace({'\'': '-', ' ': '-'})|lower})  }}">
                                    {% if p.productImages|length > 0 %}
                                      <img src="{{ vich_uploader_asset(p.productImages|first,'imageFile') }}" class="img-fluid rounded" alt="{{ p.name }}">
                                    {% else %}
                                      <div class="placeholder-img"></div>
                                    {% endif %}
                                  </a>
                            </div>
                            <div class="col-8">

                            
                                <h5 class="card-title mb-3">
                                    {{ p.name }}
                                </h5>

                              
                                <div class="row g-2">

                                    <div class="col-5">
                                        <small class="text-muted d-block">Référence</small>
                                        <span>{{ p.ref }}</span>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">Catégorie</small>
                                        <span>{{ p.category.name }}</span>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Statut</small>

                                        {% if p.isActive %}
                                            <span class="badge text-bg-success">
                                                Actif
                                            </span>
                                        {% else %}
                                            <span class="badge text-bg-danger">
                                                Inactif
                                            </span>
                                        {% endif %}
                                    </div>

                                    <div class="col-5">
                                        <small class="text-muted d-block">Prix</small>
                                        <span>{{ p.priceHt }} €</span>
                                    </div>

                                    <div class="col-4">
                                        <small class="text-muted d-block">Stock</small>
                                        <span>{{ p.stock }}</span>
                                    </div>
                                    

                                    

                                </div>
                            </div>
                  </div>
                  <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">

                      <a href="{{ path('app_admin_product_edit', {id: p.id}) }}"
                        class="btn btn-sm btn-outline-primary">
                          <span aria-hidden="true">✏️</span> Modifier
                      </a>

                      <form method="post"
                            action="{{ path('app_admin_product_delete', {id: p.id}) }}"
                            class="m-0"
                            onsubmit="return confirm('Supprimer ?');">

                          <input type="hidden"
                                name="_token"
                                value="{{ csrf_token('delete' ~ p.id) }}">

                          <button type="submit"
                                  class="btn btn-sm btn-outline-danger">
                              <span aria-hidden="true">🗑️</span> Supprimer
                          </button>

                      </form>

                  </div>

                  </div>
              </div>
          {% endfor %}
      </div>


  
      <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(products, 'partials/pagination_tamplate.html.twig') }}
  </div>
    










{% endblock %}
