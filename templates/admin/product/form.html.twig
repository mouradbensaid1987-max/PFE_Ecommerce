{% extends 'admin/base.html.twig' %}


{% block admin_body %}


<h1>{{ title }}</h1>
<div class="card mt-3">
    <div class="card-body">
        {{ form_start(form) }}
            
            <div class="row">
                <div class=" col-9">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-3 d-flex align-items-end justify-content-center pb-2 fs-5">
                    {{ form_row(form.isActive, {'label_attr': {'class': 'text-danger fw-bold'}}) }}
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6 col-md-6 col-lg-3">
                    {{ form_row(form.priceHt) }}
                </div>
                <div class="col-sm-6 col-md-6 col-lg-3">
                    {{ form_row(form.stock) }}
                </div>
                <div class="col-sm-6 col-md-6 col-lg-3">
                    {{ form_row(form.category) }}
                </div>
                <div class="col-sm-6 col-md-6 col-lg-3">
                    {{ form_row(form.tva) }}
                </div>
            </div>
            {{ form_row(form.description) }}

            <fieldset class="mt-4 pt-3 border rounded">
                  <legend class="h5 fw-semibold float-none w-auto px-2 ">Caractéristiques techniques</legend>

                  <div class="row p-2">
                      <div class="col-sm-12 col-md-4 col-lg-4">
                          {{ form_row(form.materiau) }}
                      </div>
                      <div class="col-sm-6 col-md-4 col-lg-4">
                          {{ form_row(form.longueurMm) }}
                      </div>
                      <div class="col-sm-6 col-md-4 col-lg-4">
                          {{ form_row(form.diametreMm) }}
                      </div>
                  </div>

                  <div class="row p-2">
                      <div class="col-sm-6 col-md-6 col-lg-6">
                          {{ form_row(form.typeTete) }}
                      </div>
                      <div class="col-sm-6 col-md-6 col-lg-6">
                          {{ form_row(form.typeEmpreinte) }}
                      </div>
                  </div>

                  <div class="row p-2">
                      <div class="col-sm-6 col-md-6 col-lg-6">
                          {{ form_row(form.unite) }}
                      </div>
                      <div class="col-sm-6 col-md-6 col-lg-6">
                          {{ form_row(form.quantiteConditionnement) }}
                      </div>
                  </div>
              </fieldset>
      
            <br>
            <div id="product-images-list"
                 data-prototype="{{ form_widget(form.productImages.vars.prototype)|e('html_attr') }}"
                 data-index="{{ form.productImages|length }}">
              {#{{ dump(form.productImages.vars.prototype) }}  #}         
                 {% for imageForm in form.productImages %}
                    {% set productImage = imageForm.vars.data %}
                    <div class="product-image-item border rounded p-2 mb-2 align-items-center justify-content-between">
                            {% if productImage %}
                                <img src="{{ vich_uploader_asset(productImage, 'imageFile') }}"     
                                     class="img-fluid d-block mx-auto my-2 image-preview" alt="">
                            {% endif %}
                            {{ form_widget(imageForm.imageFile) }} 
                        <button type="button" class="btn btn-danger btn-sm remove-image-btn flex-shrink-0">
                            Supprimer
                        </button>
                    </div>  
                 {% endfor %}

            </div>
            <button type="button" id="add-image-btn" class="btn btn-outline-primary">
                 Ajouter une image
            </button>

            <button type="submit" class="btn btn-primary"><i class="bi bi-floppy-fill text-danger me-1" aria-hidden="true"></i> Enregistrer</button>
            <a href="{{ path('app_admin_product_index') }}" class="btn btn-secondary">Annuler</a>
        {{ form_end(form) }}
    </div>
  </div>

{% endblock %}