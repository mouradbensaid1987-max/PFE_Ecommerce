{% extends 'base.html.twig' %}

{% block body %}
    <div class="row">
        <div class="col-md-3 mb-3">
                <div class="card">
                        <div class="card-header bg-primary text-white">
                            <strong>
                                <span aria-hidden="true">⚙️</span> Admin
                            </strong>
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="{{ path('app_admin_dashboard') }}" class="list-group-item listgroup-item-action"><i class="bi bi-speedometer2 me-2 text-primary fs-5 align-middle"></i> Tableau de bord</a>
                            <a href="{{ path('app_admin_category_index') }}" class="list-group-item list-group-item-action"><i class="bi bi-folder me-2 text-warning fs-5 align-middle"></i> Catégories</a>
                            <a href="{{ path('app_admin_tva_index') }}" class="list-group-item list-group-item-action"><i class="bi bi-cash-coin me-2 text-success fs-5 align-middle"></i> TVA</a>
                            <a href="{{ path('app_admin_product_index') }}" class="list-group-item list-group-item-action"><i class="bi bi-box-seam me-2 text-info fs-5 align-middle"></i> Produits</a>
                            <a href="{{ path('app_admin_user_index') }}" class="list-group-item list-group-item-action"><i class="bi bi-people me-2 text-primary fs-5 align-middle"></i> Utilisateurs</a>
                            <a href="{{ path('app_admin_message_index') }}"class="list-group-item list-group-item-action"><i class="bi bi-envelope me-2 text-danger fs-5 align-middle"></i> Messages</a>
                            <a href="{{ path('app_admin_order_index') }}" class="list-group-item list-group-item-action"><i class="bi bi-clipboard-check me-2 text-success fs-5 align-middle"></i> Commandes</a>
                            
                        </div>
                </div>
          </div>
        <div class="col-md-9">
            {% block admin_body %}{% endblock %}
        </div>
    </div>
{% endblock %}
