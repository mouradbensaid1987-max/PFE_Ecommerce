{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.reference }}{% endblock %}

{% block body %}

<h1>Commande {{ order.reference }}</h1>
<p class="text-muted">Passée le {{ order.createdAt|date('d/m/Y à H:i') }}</p>


<div class="row mt-3">
    <div class="col-md-9">
        <h3>Articles</h3>
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    
                    <th scope="col">Ref</th>
                    <th scope="col">Produit</th>
                    <th scope="col">Qté</th>
                    <th scope="col">Prix</th>
                    <th scope="col">Sous-total</th>
                </tr>
            </thead>

            <tbody>
                {% for item in order.items %}
                    <tr>
                        <td>{{ item.product.ref }}</td>
                        <td>
                            {{ item.product.name }}
                        </td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.priceTtc|number_format(2, ',', ' ') }} €</td>
                        <td>{{ (item.priceTtc * item.quantity)|number_format(2, ',', ' ') }}€</td>
                    </tr>
                {% endfor %}
            </tbody>

            <tfoot>
                <tr>
                    <th scope="row" colspan="4" class="text-end">Total</th>
                    <th scope="col" class="text-primary">{{ order.totalTtc|number_format(2, ',', ' ') }}€</th>
                </tr>
            </tfoot>
        </table>
    </div>



    <div class="col-md-3">
        <div class="card">
            <div class="card-header">
                <strong><span aria-hidden="true">📦</span> Livraison</strong>
            </div>

            <div class="card-body">
                {{ order.deliveryFirstName }} {{ order.deliveryLastName }}  <br>
                {{ order.deliveryStreet }}  <br>
                {{ order.deliveryPostalCode }} {{ order.deliveryCity }}  <br>
                {{ order.deliveryCountry }}
            </div>
        </div>
    </div>
</div>


<a href="{{ path('app_admin_order_index') }}" class="btn btn-secondary mt-3">← Retourner</a>
{% if order.status in ['paid','preparing', 'shipped', 'delivered'] %}
    <a href="{{ path('app_facture', {id: order.id}) }}" class="btn btn-outline-success mt-3">
        Télécharger la facture
    </a>
{% endif %}

{% endblock %}