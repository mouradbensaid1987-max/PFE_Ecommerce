{% extends 'base.html.twig' %}

{% block title %}Renvoyer l'email de confirmation{% endblock %}

{% block body %}

	<div class="row justify-content-center">

		<div class="col-md-5">

			<div class="card">

				<div class="card-body">

					<h1 class="h4 mb-2"> Renvoyer l'email de confirmation</h1>

					<p class="text-muted small mb-4">
						Vous n'avez pas reçu l'email, ou le lien a expiré (au bout d'1 heure) ?
						Indiquez votre adresse email pour en recevoir un nouveau.
					</p>

					<form method="post">
						<div class="mb-3">
							<label for="email" class="form-label">Adresse email</label>
							<input type="email" id="email" name="email" class="form-control" required autofocus>
						</div>
						<button class="btn btn-primary w-100" type="submit">Renvoyer l'email</button>
					</form>

					<div class="text-center mt-3">
						<a href="{{ path('app_login') }}" class="small">&larr; Retour à la connexion</a>
					</div>

				</div>

			</div>

		</div>

	</div>
  
{% endblock %}
