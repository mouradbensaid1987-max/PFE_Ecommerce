{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}

  <h1>{{ category.name }}</h1>
  <p class="text-muted">{{ category.description }}</p>

  <div class="row g-3">
    {% for product in products %}
      <div class="col-md-3">
        <a href="{{ path('app_product_show', {id: product.id}) }}" class="text-decoration-none text-reset">
          <div class="card h-100">
            <div class="product-image">
                      {% if product.productImages|length > 0 %}
                          <img  src="{{ vich_uploader_asset(product.productImages|first, 'imageFile') }}" 
                                class="card-img-top product-img"
                                alt="{{ product.name }}">
                      {% else %}
                          <div class="placeholder-img"></div>
                      {% endif %}
            </div>
            <div class="card-body">
              <h6>{{ product.name }}</h6>

              <p class="text-muted small mb-1">{{ product.category.name }}</p>
                {% if product.diametreMm or product.longueurMm %}
                      <p class="text-muted small mb-1">
                      {% if product.diametreMm %}
                        Ø {{ product.diametreMm }}
                      {% endif %}
                      {% if product.longueurMm %} 
                        · {{ product.longueurMm }} mm
                      {% endif %}
                      </p>
                  {% endif %}
                <p class="text-primary fw-bold mb-0"> {{ product.priceTtc|number_format(2, ',', ' ') }} € </p>
            </div>
          </div>
        </a>
      </div>
    {% else %}
      <p class="text-muted">Aucun produit dans cette catégorie.</p>
    {% endfor %}



{% endblock %}