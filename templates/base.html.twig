<!DOCTYPE html>
<html lang="fr">

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title> {% block title %} Ma Boutique {% endblock %} </title>

        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}

	</head>


	<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary"  data-bs-theme="dark">
			<div class="container">
					<a class="navbar-brand fw-bold" href="{{ path('app_home') }}">🛍️ Ma Boutique</a>
			</div>
		</nav>

		<main class="container py-4"> 
        {% block body %}{% endblock %}
		</main>
		
    
    <footer class="bg-dark text-light text-center py-4 mt-5">
			<p class="mb-0">&copy; 2025 Ma Boutique — Tous droits réservés</p>
		</footer>

  
				{% block javascripts %}{% endblock %}
	</body>

</html>
