<!DOCTYPE html>
<html lang="fr">

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title> {% block title %} Ma Boutique {% endblock %} </title>
    

        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}
        
    <link href="{{ asset('css/app.css') }}" rel="stylesheet">
  

	</head>


	<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary"  data-bs-theme="dark">

			<div class="container">

					<a class="navbar-brand fw-bold" href="{{ path('app_home') }}">🛍️ Ma Boutique</a>
			
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav me-auto">
              <li class="nav-item">
                  <a class="nav-link" href="{{ path('app_product_list') }}">Produits</a>
              </li>

              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                  Catégories
                </a>
                <ul class="dropdown-menu">
                  {% for cat in category_repository.findAll() %}
                    <li>
                      <a class="dropdown-item" href="{{ path('app_category_show', {id: cat.id}) }}"> {{ cat.name }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </li>
            </ul>

            <ul class="navbar-nav">

                <li class="nav-item me-2">
                    <a class="btn btn-outline-light btn-sm mt-1 position-relative" href="{{ path('app_cart_index') }}">🛒
                    {% if cart.getCount() > 0 %}
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                          {{ cart.getCount() }}
                        </span>
                    {% endif %}
                    </a>
                </li>


              {% if app.user %}
                    
                  <li class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle text-white" href="#" role="button" 
                          data-bs-toggle="dropdown" aria-expanded="false">
                        👤 {{ app.user.firstName }}
                      </a>
                      <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('app_profile') }}">👤 Mon profil</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_address_list') }}">📍 Mes adresses</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_order_history') }}">📦 Mes commandes</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_favorites') }}">❤️ Mes favoris</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_message_index') }}">✉️ Mes messages</a></li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ path('app_admin_dashboard') }}"><i class="bi bi-speedometer2"></i> Administration</a></li>
                        {% endif %}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Se déconnecter</a></li>
                      </ul>
                  </li>
              {% else %}
                  <li class="nav-item">
                      <a class="nav-link text-white" href="{{ path('app_login') }}">Connexion</a>
                  </li>
                  <li class="nav-item">
                      <a class="btn btn-light btn-sm ms-2 mt-1" href="{{ path('app_register') }}">Inscription</a>
                  </li>
              {% endif %}
            </ul>

          </div>
      </div>
		</nav>


		<main class="container py-4">
    
        {% for label, messages in app.flashes %}
          {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show">
              {{ message }}
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
		</main>
		
  
    <footer class="bg-dark text-light text-center py-4 mt-5">
			<p class="mb-0">&copy; 2026 Ma Boutique — Tous droits réservés</p>
		</footer>

				{% block javascripts %}{% endblock %}
	</body>

</html>
