{% extends 'base.html.twig' %}
{% block title %}Nouveau mot de passe{% endblock %}
{% block body %}

	<div class="row justify-content-center">

		<div class="col-md-5">

			<div class="card">

				<div class="card-body">

					<h1 class="h3 mb-4"> Choisissez un nouveau mot de passe</h1>

					{{ form_start(resetForm) }}

					    {{ form_row(resetForm.plainPassword.first) }}
					    {{ form_row(resetForm.plainPassword.second) }}

					    <button class="btn btn-primary w-100 mt-2" type="submit">Réinitialiser le mot de passe</button>

					{{ form_end(resetForm) }}

				</div>

			</div>

		</div>
    
	</div>

{% endblock %}

