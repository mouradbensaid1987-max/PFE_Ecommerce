{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié ?
{% endblock %}
{% block body %}

	<div class="row justify-content-center">

		<div class="col-md-5">

			<div class="card">

				<div class="card-body">

					<h1 class="h3 mb-2"> Mot de passe oublié ?</h1>

					<p class="text-muted small mb-4">
						Indiquez votre adresse email : si un compte existe, vous recevrez
						un lien pour réinitialiser votre mot de passe.
					</p>

					{{ form_start(requestForm) }}

					    {{ form_row(requestForm.email) }}
					      <button class="btn btn-primary w-100 mt-2" type="submit">Envoyer le lien</button>

					{{ form_end(requestForm) }}

					<div class="text-center mt-3">
						    <a href="{{ path('app_login') }}" class="small">&larr; Retour à la connexion</a>
					</div>

				</div>

			</div>

		</div>

	</div>
{% endblock %}
