{% extends 'base.html.twig' %}
{% block title %}Vérifiez vos emails{% endblock %}
{% block body %}

	<div class="row justify-content-center">

		<div class="col-md-5">

			<div class="card text-center">

				<div class="card-body p-5">

					<div class="mb-3" style="font-size: 2.5rem;"></div>

					<h1 class="h4 mb-3">Vérifiez votre boîte mail</h1>

					<p class="text-muted">
						Si un compte existe avec cette adresse, un email contenant un lien
						de réinitialisation vient de vous être envoyé.
					</p>

					<a href="{{ path('app_login') }}" class="btn btn-outline-primary mt-2">Retour à la connexion</a>

				</div>

			</div>

		</div>
    
	</div>

{% endblock %}
