{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}

    <h1><span aria-hidden="true">✏️</span> Modifier mon profil</h1>

    <div class="card mt-3">
    
      <div class="card-body">

        {{ form_start(form) }}

            {{ form_widget(form) }}

            <button class="btn btn-primary">
                <span aria-hidden="true">💾</span> Enregistrer
            </button>

            <a href="{{ path('app_profile') }}" class="btn btn-secondary">Annuler</a>

        {{ form_end(form) }}

      </div>
    </div>



{% endblock %}