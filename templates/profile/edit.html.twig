{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}

    <h1><i class="bi bi-pencil-fill text-danger me-2" aria-hidden="true"></i>Modifier mon profil</h1>

    <div class="card mt-3">
    
      <div class="card-body">

        {{ form_start(form) }}

            {{ form_widget(form) }}

            <button class="btn btn-primary">
                <i class="bi bi-floppy-fill text-danger me-1" aria-hidden="true"></i> Enregistrer
            </button>

            <a href="{{ path('app_profile') }}" class="btn btn-secondary">Annuler</a>

        {{ form_end(form) }}

      </div>
    </div>



{% endblock %}