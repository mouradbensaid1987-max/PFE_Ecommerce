<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>Facture {{ order.reference }}</title>

		<style>

      @page {
          margin: 1mm 18mm 15mm 18mm; /* haut/bas 15mm, gauche/droite 20mm */
      }
			/* ===== Reset ===== */
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: DejaVu Sans, Arial, sans-serif;
				font-size: 13px;
				color: #212529;
				background: #fff;
		/
			}
      .t {
        font-size: 10px;
    }

			/* ===== Utilitaires "Bootstrap-like" compatibles Dompdf ===== */
			.text-center { text-align: center; }
			.text-end { text-align: right; }
			.text-start { text-align: left; }

			.text-primary { color: #1e4a8a; }
			.text-muted { color: #6c757d; }
			.text-white { color: #fff; }

			.bg-primary { background-color: #1e4a8a; }
			.bg-light { background-color: #f8f9fa; }

			.fw-bold { font-weight: bold; }

			.rounded { border-radius: 6px; }

			.border { border: 1px solid #dee2e6; }

			.mb-1 { margin-bottom: 5px; }
			.mb-2 { margin-bottom: 10px; }
			.mb-3 { margin-bottom: 15px; }
			.mb-4 { margin-bottom: 25px; }
			.mt-3 { margin-top: 15px; }
			.mt-4 { margin-top: 25px; }
			.p-3 { padding: 15px; }

			/* ===== Badge (composant Bootstrap simple, compatible) ===== */
			.badge {
				display: inline-block;
				padding: 4px 10px;
				border-radius: 4px;
				font-size: 12px;
				font-weight: bold;
			}
			.badge-success {
				background-color: #1e4a8a;
				color: #fff;
			}

			/* ===== Table Bootstrap (composant compatible, pas de flex requis) ===== */
			.table {
				width: 100%;
				border-collapse: collapse;
			}
			.table th,
			.table td {
				padding: 10px;
				border: 1px solid #dee2e6;
				vertical-align: middle;
			}
			.table thead {
				background-color: #1e4a8a;
				color: #fff;
			}
			.table thead th {
				border: 1px solid #1e4a8a;
			}
			.table-striped tbody tr:nth-child(even) {
				background-color: #f8f9fa;
			}

			/* ===== Mise en page (remplace le système de grille flex) ===== */
			/* Dompdf ne supporte pas display:flex correctement,
			   on utilise donc de vraies <table> HTML pour la mise en page,
			   ce qui est l'équivalent "compatible PDF" du système de grille Bootstrap. */
			.layout-table {
				width: 100%;
			}
			.layout-table td {
				vertical-align: top;
			}

			.header {
				border-bottom: 3px solid #1e4a8a;
				padding-bottom: 20px;
				margin-bottom: 30px;
			}

			

			.invoice-title h1 {
				font-size: 28px;
				color: #1e4a8a;
			}

			.total-table {
				width: 40%;
				margin-left: auto;
				margin-top: 20px;
				border-collapse: collapse;
			}
			.total-table td {
				padding: 10px;
				border: 1px solid #dee2e6;
			}
			.total-table .total {
				background-color: #1e4a8a;
				color: #fff;
				font-size: 16px;
				font-weight: bold;
			}

			.footer {
				margin-top: 60px;
				border-top: 1px solid #dee2e6;
				padding-top: 15px;
				text-align: center;
				font-size: 11px;
				color: #6c757d;
			}
      .vignette-100 {
          width: 100px;
          height: 100px;
          object-fit: cover;
      }
		</style>
    

	</head>

	<body>

		<div class="container border p-3">

			<div class="header">
				<table class="layout-table">
					<tr>
						<td>
							<div>
								<img src="{{ logoPath }}" class="vignette-100" alt="Ma Boutique">
							</div>
							<p class="text-muted mt-3">
								15 Rue Exemple<br>
								75000 Paris<br>
								France
							</p>
						</td>

						<td class="invoice-title text-end">
							<h1>FACTURE</h1>
							<p class="mt-3"><strong>N° :</strong> {{ order.reference }}</p>
							<p><strong>Date :</strong> {{ order.createdAt|date('d/m/Y') }}</p>
              <div><span class="badge badge-success mt-3">Facture acquittée</span></div>
					
                
						</td>
					</tr>
				</table>
			</div>

			<table class="layout-table mb-4">
				<tr>
					<td style="width:33%; padding-right:15px;">
						<div class="border rounded p-3">
							<div class="text-primary fw-bold mb-2">Vendeur</div>
							Ma Boutique<br>
							15 Rue Exemple<br>
							75000 Paris<br>
							France<br>
						</div>
					</td>
					<td style="width:33%; padding-right:15px;">
						<div class="border rounded p-3">
							<div class="text-primary fw-bold mb-2">Client</div>
							{{ order.user.firstname }} {{ order.user.lastname }}<br>
							{{ order.user.email }}
            
						</div>
          </td>
          <td style="width:33%;">
            <div class="border rounded p-3">
							<div class="text-primary fw-bold mb-2">Adresse de livraison</div>
              {{ order.deliveryFirstName }} {{ order.deliveryLastName }}<br>

              {{ order.deliveryStreet}}<br>
              {{ order.deliveryPostalCode}} {{ order.deliveryCity }} <br>
              {{ order.deliveryCountry }}
						</div>
					</td>
				</tr>
			</table>
      {% set totalHt = 0 %}

			<table class="table table-striped">
				<thead>
					<tr>
            <th width="50" class="text-center t">Ref</th>
						<th width="120" class="text-center t">Produit</th>
						<th width="20" class="text-center t">Qté</th>
            <th width="50" class="text-center t">Prix U HT</th>
            <th width="50" class="text-center t">TVA</th>
						<th width="50" class="text-center t">Prix U TTC</th>
						<th width="80" class="text-center t">Sous-total TTC</th>
					</tr>
				</thead>
				<tbody>
					{% for item in order.items %}
					<tr>
            <td class="text-center">{{ item.product.ref }}</td>
						<td class="text-center">{{ item.product.name }}</td>
						<td class="text-center">{{ item.quantity }}</td>
            <td class="text-center">{{ ((100 * item.priceTtc)/(100 + item.tva))|number_format(2, ',', ' ')  }} €</td>
            <td class="text-center">{{ item.tva }} %</td>
						<td class="text-center">{{ item.priceTtc|number_format(2, ',', ' ') }} €</td>
						<td class="text-center">{{ (item.quantity * item.priceTtc)|number_format(2, ',', ' ') }} €</td>
                {% set prixHt = (100 * item.priceTtc) / (100 + item.tva) %}
                {% set totalHt = totalHt + (prixHt * item.quantity) %}
					</tr>
					{% endfor %}
				</tbody>
			</table>


			<table class="total-table">
				<tr>
					<td class="text-center">Total HT</td>
					<td class="text-center">{{ totalHt|number_format(2, ',', ' ') }} €</td>
				</tr>
        <tr>
					<td class="text-center">Sous Total TTC</td>
					<td class="text-center">{{ (order.totalTtc - order.shippingCost)|number_format(2, ',', ' ') }} €</td>
				</tr>
        <tr>
					<td class="text-center">Frais de Livraison</td>
					<td class="text-center">{{ order.shippingCost|number_format(2, ',', ' ') }} €</td>
				</tr>

				<tr class="total">
					<td class="text-center">Total TTC</td>
					<td class="text-center">{{ order.totalTtc|number_format(2, ',', ' ') }} €</td>
				</tr>
			</table>



			<div class="footer">
				Merci pour votre confiance.<br>
				Facture conforme à l'article L441-9 du Code de commerce.<br>
				TVA non applicable selon votre régime fiscal (à adapter selon votre entreprise).
			</div>

		</div>

	</body>
</html>
