<div class="card h-100 product-card shadow-sm">
    <div class="row g-0 h-100">

        <div class="col-6">
            <a href="{{ path('app_product_show',{id: product.id}) }}" class="text-decoration-none text-reset d-block h-100">
                <div class="product-image position-relative h-100">
                    {% if product.productImages|length > 0 %}
                        <img  src="{{ vich_uploader_asset(product.productImages|first, 'imageFile') }}" 
                              class="product-img w-100 h-100"
                              style="object-fit: cover; border-radius: 0.375rem 0 0 0.375rem;"
                              loading="lazy"
                              decoding="async"
                              alt="{{ product.name }}">
                    {% else %}
                        <div class="placeholder-img d-flex align-items-center justify-content-center w-100 h-100">
                            <span class="text-muted small">Pas d'image</span>
                        </div>
                    {% endif %}
                  
                </div>
            </a>
        </div>

        <div class="col-6">
            <div class="d-flex flex-column h-100 p-2">
                <a href="{{ path('app_product_show',{id: product.id}) }}" class="text-decoration-none text-reset">
                    <h6 class="card-title mb-1 text-truncate">{{ product.name }}</h6>
                    <p class="text-muted small mb-1">{{ product.ref }}</p>
                    {% if product.diametreMm or product.longueurMm %}
                        <p class="text-muted small mb-1">
                            {% if product.diametreMm %}
                                Ø {{ product.diametreMm }}
                            {% endif %}
                            {% if product.longueurMm %}
                                · {{ product.longueurMm }} mm
                            {% endif %}
                        </p>
                    {% endif %}
                </a>

                <div class="mt-auto">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                            <p class="text-primary fw-bold mb-2">Prix : {{ product.priceTtc|number_format(2, ',', ' ') }} €</p>
                            {% if product.stock is defined %}
                                <p class="small fw-normal mb-2 badge {{ product.stock <= 0 ? 'bg-danger' : (product.stock <= 5 ? 'bg-warning text-dark' : 'text-success') }}">
                                    {% if product.stock <= 0 %}
                                        <i class="bi bi-x-circle"></i> Rupture
                                    {% elseif product.stock <= 5 %}
                                        <i class="bi bi-exclamation-triangle"></i> {{ product.stock }} restant{{ product.stock > 1 ? 's' : '' }}
                                    {% else %}
                                        <i class="bi bi-check-circle"></i> En stock({{ product.stock }})
                                    {% endif %}
                                </p>
                            {% endif %}
                    </div>


                    <div class="d-flex gap-1">
                          <form action="{{ path('app_cart_add', {id: product.id}) }}" method="post" class="flex-grow-1 mb-0">
                              <button type="submit" class="btn btn-primary btn-sm w-100" {% if product.stock is defined and product.stock <= 0 %}disabled{% endif %}>
                                  {% if product.stock is defined and product.stock <= 0 %}
                                      Indisponible
                                  {% else %}
                                      Ajouter au panier
                                  {% endif %}
                              </button>
                          </form>
                          {% if app.user %}
                            {% set isFavorite = product.id in favoriteIds %}
                            <form method="post" action="{{ path('app_favorite_toggle', {id: product.id}) }}" class="mb-0">
                                <button class="btn btn-outline-danger btn-sm" title="Ajouter aux favoris">
                                    <i class="bi {{ isFavorite ? 'bi-heart-fill' : 'bi-heart' }}"></i>
                                </button>
                            </form>
                          {% endif %}
                        </div>
                </div>
            </div>
        </div>

    </div>
</div>