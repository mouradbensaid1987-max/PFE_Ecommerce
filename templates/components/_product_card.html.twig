<div class="card h-100 product-card shadow-sm">
    <a href="{{ path('app_product_show',{id: product.id, slug: product.slug|replace({'\'': '-', ' ': '-'})|lower}) }}" class="text-decoration-none text-reset">
        <div class="product-image position-relative">
            {% if product.productImages|length > 0 %}
                <img  src="{{ vich_uploader_asset(product.productImages|first, 'imageFile') }}" 
                      class="card-img-top product-img"
                      loading="lazy"
                      decoding="async"
                      alt="{{ product.name }}">
            {% else %}
                <div class="placeholder-img d-flex align-items-center justify-content-center">
                    <span class="text-muted small">Pas d'image</span>
                </div>
            {% endif %}

        </div>

        <div class="px-2 pt-2">
            <h6 class="card-title mb-1 text-truncate">{{ product.name }}</h6>
            <p class="text-muted small mb-1">{{ product.ref }}</p>
            {% if product.diametreMm or product.longueurMm %}
                  <p class="text-muted small mb-1">
                  {% if product.diametreMm %}
                    Ø {{ product.diametreMm }}
                  {% endif %}
                  {% if product.longueurMm %} 
                    · {{ product.longueurMm }} mm
                  {% endif %}
                  </p>
            {% else %}
                
            {% endif %}
        </div>
    </a>
    <div class="card-body d-flex flex-column pt-0">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-primary fw-bold mb-0"> Prix: {{ product.priceTtc|number_format(2, ',', ' ') }} € </p>
            {% if product.stock is defined %}
              <p class="small fw-normal m-0 badge {{ product.stock <= 0 ? 'bg-danger' : (product.stock <= 5 ? 'bg-warning text-dark' : 'bgsuccess-subtle text-success-emphasis') }}">
                  {% if product.stock <= 0 %}
                      <i class="bi bi-x-circle" aria-hidden="true"></i> Rupture
                  {% elseif product.stock <= 5 %}
                      <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> {{ product.stock }} restant{{ product.stock > 1 ? 's' : '' }}
                  {% else %}
                      <i class="bi bi-check-circle" aria-hidden="true"></i> En stock({{ product.stock }})
                  {% endif %}
              </p>
          {% endif %}
    </div>




        <div class="d-flex gap-1 mt-auto">
              <form action="{{ path('app_cart_add', {id: product.id}) }}" method="post" class="flex-grow-1">
                  <button type="submit" class="btn btn-primary btn-sm w-100" {% if product.stock is defined and product.stock <= 0 %}disabled{% endif %}>
                      
                      {% if product.stock is defined and product.stock <= 0 %}
                          Indisponible
                      {% else %}
                          Ajouter au panier
                      {% endif %}
                  </button>
              </form>
              {% if app.user %}
                {% set isFavorite = product.id in favoriteIds %}
                <form method="post" action="{{ path('app_favorite_toggle', {id: product.id}) }}">
                    <button class="btn btn-outline-danger btn-sm" 
                            aria-label="{{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}" 
                            title= " {{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">
                         <i class="bi {{ isFavorite ? 'bi-heart-fill' : 'bi-heart' }}"  aria-hidden="true"></i>
                         
                    </button>
                </form>
              {% endif %}
        </div>
    </div>
</div>