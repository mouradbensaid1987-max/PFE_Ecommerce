{# templates/partials/_footer.html.twig #}
<footer class="footer bg-dark text-light mt-5" role="contentinfo">
    <div class="container py-4">
        <div class="row align-items-center gy-3 text-center text-md-start">

            {# Marque #}
            <div class="col-md-4">
                <a href="{{ path('app_home') }}" class="h5 fw-bold text-white text-decoration-none">FixPro</a>
                <p class="text-secondary small mb-0">La visserie et la fixation pour vos projets.</p>
            </div>

            {# Liens #}
            <nav class="col-md-4 text-md-center" aria-label="Liens du pied de page">
                <a href="{{ path('app_home') }}" class="footer-link me-3">Accueil</a>
                <a href="{{ path('app_product_list') }}" class="footer-link">Produits</a>
            </nav>

            {# Contact #}
            <address class="col-md-4 text-md-end small mb-0">
                <a href="mailto:contact@fixpro.fr" class="footer-link">contact@fixpro.fr</a><br>
                <a href="tel:+33200000000" class="footer-link">02 00 00 00 00</a>
            </address>

        </div>

        {# Barre du bas #}
        <div class="border-top border-secondary border-opacity-25 mt-4 pt-3 d-md-flex justify-content-between text-center small">
            <span class="text-secondary">&copy; {{ 'now'|date('Y') }} FixPro. Tous droits réservés.</span>
            <span>
                <a href="{{ path('app_legal_notice') }}" class="footer-link me-3">Mentions légales</a>
                <a href="{{ path('app_legal_cgu') }}" class="footer-link">CGU</a>
            </span>
        </div>
    </div>
</footer>