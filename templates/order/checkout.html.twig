{% extends 'base.html.twig' %}

{% block title %}Validation de la commande{% endblock %}

{% block body %}

<h1>📋 Validation de votre commande</h1>

  <div class="row mt-4">
      <div class="col-md-5">
          <h3>📦 Choisir une adresse de livraison</h3>
          {% if deliveryAddresses|length == 0 %}
              <div class="alert alert-warning">
                  Vous n'avez aucune adresse de livraison.
                  <a href="{{ path('app_address_new') }}" class="alert-link">En ajouter une</a>
              </div>
          {% else %}
              <form method="post" action="{{ path('app_order_confirm') }}">
                  {% for address in deliveryAddresses %}
                      <div class="card mb-2">
                          <div class="card-body">
                              <div class="form-check">

                                    <input type="radio" 
                                           name="address_id"
                                           value="{{ address.id }}"
                                           id="addr_{{ address.id }}"
                                           class="form-check-input"
                                           {% if loop.first %}checked{% endif %}>

                                    <label for="addr_{{ address.id }}" class="form-check-label">
                                        <strong> {{ address.firstName }} {{ address.lastName }} </strong><br>
                                        {{ address.street }}<br>
                                        {{ address.postalCode }} {{ address.city }}
                                    </label>

                              </div>
                          </div>
                      </div>
                  {% endfor %}

                  <button class="btn btn-primary btn-lg w-100 mt-3"> Continuer vers le paiement → </button>
              </form>
          {% endif %}
      </div>

      <div class="col-md-7">
        <div class="card">

            <div class="card-header bg-primary text-white">
                <strong>🛒 Récapitulatif</strong>
            </div>

            <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Quantité</th>
                            <th>Prix TTC</th>
                            <th>Total TTC</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set total = 0 %}
                        {% for item in items %}
                            <tr>
                                <td>{{ item.product.name }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>{{ item.product.priceTtc }} €</td>
                                <td>{{ (item.product.priceTtc * item.quantity)|number_format(2,',', ' ') }} €</td>
                            </tr>
                            {% set total = total + (item.product.priceTtc) *(item.quantity) %}
                        {% endfor %}
                    </tbody>
                </table>
                <h4 class="text-end">
                    Total TTC : <strong>{{ total|number_format(2, ',', ' ') }}€</strong>
                </h4>

        </div>
      </div>

  </div>

{% endblock %}