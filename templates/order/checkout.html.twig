{% extends 'base.html.twig' %}

{% block title %}Validation de la commande{% endblock %}

{% block body %}

<h1>📋 Validation de votre commande</h1>

  <div class="row mt-4 g-4">

      <div class="col-md-7">
        <div class="card shadow-sm border-0">

          <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
              <span><strong>Récapitulatif de la commande</strong></span>
              <span class="badge bg-light text-primary">{{ items|length }} article{{ items|length > 1 ? 's' : '' }}</span>
          </div>

          <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                      <tr>
                          <th>Produit</th>
                          <th class="text-center">Qté</th>
                          <th class="text-end">Prix unitaire</th>
                          <th class="text-end">Total</th>
                      </tr>
                  </thead>
                  <tbody>
                      {% for item in items %}
                          <tr>
                              <td class="fw-medium">{{ item.product.name }}</td>
                              <td class="text-center">
                                  <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ item.quantity }}</span>
                              </td>
                              <td class="text-end text-muted">{{ item.product.priceTtc|number_format(2, ',', ' ') }} €</td>
                              <td class="text-end fw-semibold">{{ (item.product.priceTtc * item.quantity)|number_format(2, ',', ' ') }} €</td>
                          </tr>
                      {% endfor %}
                  </tbody>
              </table>
          </div>

          <div class="card-body border-top">
              <ul class="list-unstyled mb-0">
                  <li class="d-flex justify-content-between mb-2">
                      <span class="text-muted">Sous-total TTC</span>
                      <span>{{ total|number_format(2, ',', ' ') }} €</span>
                  </li>
                  <li class="d-flex justify-content-between mb-2">
                      <span class="text-muted">
                          <i class="bi bi-truck me-1"></i>Frais de livraison
                      </span>
                      {% if shippingFee == 0 %}
                          <span class="badge bg-success-subtle text-success-emphasis">Gratuit</span>
                      {% else %}
                          <span>{{ shippingFee|number_format(2, ',', ' ') }} €</span>
                      {% endif %}
                  </li>

                  <li><hr class="my-2"></li>

                  <li class="d-flex justify-content-between align-items-center">
                      <span class="h5 mb-0">Total à payer</span>
                      <span class="h4 mb-0 text-primary fw-bold">{{ totalWithShipping|number_format(2, ',', ' ') }} €</span>
                  </li>
              </ul>

              {% if shippingFee > 0 %}
                  <p class="text-muted small mt-3 mb-0">
                      
                      Livraison gratuite dès 50,00 € d'achat.
                  </p>
              {% endif %}
          </div>
      </div>
      </div>
    

      <div class="col-md-5">
          <h3>📦 Choisir une adresse de livraison</h3>
          {% if deliveryAddresses|length == 0 %}
              <div class="alert alert-warning">
                  Vous n'avez aucune adresse de livraison.
                  <a href="{{ path('app_address_new') }}" class="alert-link">En ajouter une</a>
              </div>
          {% else %}
              <form method="post" action="{{ path('app_order_confirm') }}">
                  {% for address in deliveryAddresses %}
                      <div class="card mb-2">
                          <div class="card-body">
                              <div class="form-check">

                                    <input type="radio" 
                                           name="address_id"
                                           value="{{ address.id }}"
                                           id="addr_{{ address.id }}"
                                           class="form-check-input"
                                           {% if loop.first %}checked{% endif %}>

                                    <label for="addr_{{ address.id }}" class="form-check-label">
                                        <strong> {{ address.firstName }} {{ address.lastName }} </strong><br>
                                        {{ address.street }}<br>
                                        {{ address.postalCode }} {{ address.city }}
                                    </label>

                              </div>
                          </div>
                      </div>
                  {% endfor %}

                  <button class="btn btn-primary btn-lg w-100 mt-3"> Continuer vers le paiement → </button>
              </form>
          {% endif %}
      </div>

      
  </div>

  </div>

{% endblock %}