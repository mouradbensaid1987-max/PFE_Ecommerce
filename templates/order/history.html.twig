{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}

<h1>📋 Mes commandes</h1>

{% if orders|length == 0 %}
    <div class="alert alert-info">Vous n'avez pas encore passé de commande.</div>
{% else %}


<table class="table mt-3">
    <thead>
        <tr>
            <th>Référence</th>
            <th>Date</th>
            <th>Articles</th>
            <th>Total</th>
            <th>Statut</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
      {% for order in orders %}
        <tr>
            <td>{{ order.reference }}</td>
            <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
            <td>{{ order.items|length }}</td>
            <td>{{ order.totalTtc|number_format(2, ',', ' ') }} €</td>
            <td>
                {% if order.status == 'pending' %}
                    <span class="badge bg-warning">En attente</span>
                {% elseif order.status == 'paid' %}
                    <span class="badge bg-info">Payée</span>
                {% elseif order.status == 'shipped' %}
                    <span class="badge bg-primary">Expédiée</span>
                {% elseif order.status == 'delivered' %}
                    <span class="badge bg-success">Livrée</span>
                {% endif %}
            </td>
            <td>
                <a  href="{{ path('app_order_show', {ref: order.reference}) }}"
                    class="btn btn-sm btn-outline-primary">Détails</a>
            </td>
        </tr>
      {% endfor %}

    </tbody>
    
</table>

{% endif %}



{% endblock %}