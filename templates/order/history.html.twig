{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}

<h1><span aria-hidden="true">📋</span> Mes commandes</h1>

{% if orders|length == 0 %}
    <div class="alert alert-info">Vous n'avez pas encore passé de commande.</div>
{% else %}


<table class="table mt-3">
    <thead>
        <tr>
            <th scope="col">Référence</th>
            <th scope="col">Date</th>
            <th scope="col">Articles</th>
            <th scope="col">Total</th>
            <th scope="col">Statut</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
      {% for order in orders %}
        <tr>
            <td>{{ order.reference }}</td>
            <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
            <td>{{ order.items|length }}</td>
            <td>{{ order.totalTtc|number_format(2, ',', ' ') }} €</td>
            <td >
                    {% if order.status == 'paid' %}
                      <span class="badge text-dark text-bg-info fs-6">Payée</span>
                    {% elseif order.status == 'shipped' %}
                      <span class="badge text-dark text-bg-info fs-6">Expédiée</span>
                    {% elseif order.status == 'delivered' %}
                      <span class="badge text-dark text-bg-info fs-6">Livrée</span>
                    {% elseif order.status == 'cancelled' %}
                      <span class="badge text-dark text-bg-danger fs-6">Annulée</span>
                    {% elseif order.status == 'pending' %}
                      <span class="badge text-dark text-bg-warning fs-6">En attente</span>
                    {% endif %}
            </td>
            <td>
                <a  href="{{ path('app_order_show', {id: order.id}) }}"
                    class="btn btn-sm btn-outline-primary">Détails</a>
            </td>
        </tr>
      {% endfor %}

    </tbody>
    
</table>

{% endif %}



{% endblock %}