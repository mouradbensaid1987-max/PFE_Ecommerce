{% extends 'base.html.twig' %}

{% block title %}
	Accueil
{% endblock %}

{% block body %}

<div class="hero-quincaillerie text-white p-5 rounded mb-4 position-relative overflow-hidden" id="heroBanner">


  <button type="button" id="heroPauseBtn"
          class="btn btn-sm btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2"
          style="z-index: 10;"
          aria-pressed="false"
          aria-label="Mettre en pause le diaporama"
    >
        <i class="bi bi-pause-fill" aria-hidden="true"></i>
  </button>

  
    <div class="hero-slide" style="background-image: url('{{ asset('images/aaa.webp') }}'); animation-delay: 0s;"></div>
    <div class="hero-slide" style="background-image: url('{{ asset('images/aaa1.jpg') }}'); animation-delay: 5s;"></div>
    <div class="hero-slide" style="background-image: url('{{ asset('images/aaa2.avif') }}'); animation-delay: 10s;"></div>
    <div class="hero-slide" style="background-image: url('{{ asset('images/aaa3.avif') }}'); animation-delay: 15s;"></div>
    <div class="hero-slide" style="background-image: url('{{ asset('images/aaa4.jpg') }}'); animation-delay: 20s;"></div>

    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-end" 
         style="background: linear-gradient(90deg, rgba(10,20,40,0.65) 0%, rgba(10,20,40,0.35) 45%, rgba(10,20,40,0) 75%);"></div>

     <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-end p-5">
        <div class="hero-card p-3 p-md-4" style="max-width: 380px;">
            <h1 class="fw-bold fs-5 mb-2" style="text-shadow: 0 2px 10px rgba(0,0,0,0.4);">
                Toute la visserie professionnelle
            </h1>
            <p class="mb-3" style="font-size: 0.9rem; text-shadow: 0 1px 6px rgba(0,0,0,0.4); opacity: 0.95;">
                Vis, boulons et fixations pour tous vos projets.
                Large choix de matériaux, diamètres et conditionnements, au meilleur prix.
            </p>

            <a href="{{ path('app_product_list') }}" class="btn btn-light btn-sm fw-semibold px-3">
                Voir les Produits
            </a>
        </div>
    </div>
  
</div>

{#------------------------------------------category---------------------------------------------------------------------- #}
<div class="d-flex align-items-center">

    <!-- Flèche gauche -->
    <button class="carousel-control-prev position-static flex-shrink-0 w-auto px-2 version-sm-plus"
            type="button"
            data-bs-target="#productCarousel"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon bg-dark rounded-circle"
              aria-hidden="true"></span>
        <span class="visually-hidden">Catégorie précédente</span>
    </button>

    <!-- Carousel -->
    <div id="productCarousel" class="carousel slide flex-grow-1 version-sm-plus">
        <div class="carousel-inner">
            {% for chunk in categories|batch(4) %}
                <div class="carousel-item {{ loop.first ? 'active' : '' }}">

                    <div class="row justify-content-center g-3">

                        {% for cat in chunk %}
                            <div class="col-md-3 col-sm-6">
                                <a href="{{ path('app_category_show', {id: cat.id}) }}" class="text-decoration-none">
                                  
                                    <div class="card h-100">
                                        <div class="text-center rounded bg-primary bottom-0 start-0 end-0">
                                            <p class="text-white fw-bold m-3">
                                                {{ cat.name }}
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <!-- Flèche droite -->
    <button class="carousel-control-next position-static flex-shrink-0 w-auto px-2 version-sm-plus"
            type="button"
            data-bs-target="#productCarousel"
            data-bs-slide="next">
        <span class="carousel-control-next-icon bg-dark rounded-circle"
              aria-hidden="true"></span>
        <span class="visually-hidden">Catégorie suivante"</span>
    </button>


      <!-- Carousel2 -->
    <!-- Flèche gauche -->
    <button class="carousel-control-prev position-static flex-shrink-0 w-auto px-2 version-mobile"
            type="button"
            data-bs-target="#productCarousel2"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon bg-dark rounded-circle"
              aria-hidden="true"></span>
        <span class="visually-hidden">Catégorie précédente</span>
    </button>

    <div id="productCarousel2" class="carousel slide flex-grow-1 version-mobile">
        <div class="carousel-inner">
            {% for chunk in categories|batch(2) %}
                <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                    <div class="row justify-content-center g-3">
                        {% for cat in chunk %}
                            <div class="col-6">
                                <a href="{{ path('app_category_show', {id: cat.id}) }}" class="text-decoration-none">
                                    <div class="card h-100">
                                        <div class="text-center rounded bg-primary bottom-0 start-0 end-0">
                                            <p class="text-white fw-bold m-3">
                                                {{ cat.name }}
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    
    <!-- Flèche droite -->
    <button class="carousel-control-next position-static flex-shrink-0 w-auto px-2 version-mobile"
            type="button"
            data-bs-target="#productCarousel2"
            data-bs-slide="next">
        <span class="carousel-control-next-icon bg-dark rounded-circle"
              aria-hidden="true"></span>
        <span class="visually-hidden">Catégorie suivante"</span>
    </button>

</div>

{#---------------------------------------Product------------------------------------------------------------- #}

    <h2 class="mb-3">Nos Produits</h2>
      <div class="version-sm-plus">
        <div class="row g-3">
        {% for product in products %}
          <div class="col-lg-3 col-md-4 col-sm-6">
              {% include 'components/_product_card.html.twig' with {product: product} %}
          </div>
        {% endfor %}
      </div>
    </div>
      <div class="version-mobile">
        <div class="row g-3">
          {% for product in products %}
            {% include 'components/_product_card_smull.html.twig' with {product: product} %}
          {% endfor %}
        </div>
      </div>



{% endblock %}

