{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}

<h1 class="mb-4">Mon panier</h1>

{% if items|length == 0 %}
    <div class="alert alert-info mt-3 d-flex align-items-center">
        
        <div>
            Votre panier est vide.
            <a href="{{ path('app_product_list') }}" class="alert-link">Voir nos produits</a>
        </div>
    </div>
{% else %}

<div class="row g-4">

    {# ===================== Colonne produits ===================== #}
    <div class="col-lg-9">
        <div class="card shadow-sm border-2">
              <div class="card-header bg-white d-flex align-items-center justify-content-between">
                  <strong>Articles</strong>
                  <span class="badge bg-secondary-subtle text-secondary-emphasis">
                      {{ items|length }} produit{{ items|length > 1 ? 's' : '' }}
                  </span>
              </div>

              <div class="version-sm-plus">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr class="bg-primary text-white">
                            <th class="bg-primary text-white">Img</th>
                            <th class="bg-primary text-white">Ref</th>
                            <th class="bg-primary text-white">Produit</th>
                            <th class="bg-primary text-white">Quantité</th>
                            <th class="bg-primary text-white text-end">Prix-U</th>
                            <th class="bg-primary text-white text-end">S-total</th>
                            <th class="bg-primary text-white text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_product_show', {id: item.product.id}) }}">
                                      <div class="admin-product-image">
                                          {% if item.product.productImages|length > 0 %}
                                              <img  src="{{ vich_uploader_asset(item.product.productImages|first, 'imageFile') }}"
                                                    class="admin-product-img"  
                                                    alt="{{ item.product.name }}">
                                          {% else %}
                                              <div class="placeholder-img"></div>
                                          {% endif %}
                                      </div>
                                    </a>
                                </td>
                                <td>{{ item.product.ref }}</td>
                                <td>
                                    <a href="{{ path('app_product_show', {id: item.product.id}) }}"
                                       class="text-decoration-none text-dark fw-medium">
                                        {{ item.product.name }}
                                    </a>
                                </td>

                                <td>
                                    <form method="post"
                                          action="{{ path('app_cart_update', {id: item.product.id}) }}"
                                          class="d-flex gap-2">
                                        <input type="number"
                                               name="quantity"
                                               value="{{ item.quantity }}"
                                               min="0"
                                               class="form-control form-control-sm text-center"
                                               style="max-width:70px">
                                        <button class="btn btn-sm btn-outline-primary" title="Mettre à jour">
                                            ↻
                                        </button>
                                    </form>
                                </td>

                                <td class="text-end text-muted">
                                    {{ item.product.priceTtc|number_format(2, ',', ' ') }} €
                                </td>

                                <td class="text-end fw-semibold">
                                    {{ (item.product.priceTtc * item.quantity)|number_format(2, ',', ' ') }} €
                                </td>

                                <td class="text-end">
                                    <a href="{{ path('app_cart_product_remove', {id: item.product.id}) }}"
                                       class="btn btn-sm btn-outline-danger"
                                       title="Retirer l'article">
                                        🗑️
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        
                    </tbody>
                    {% if items|length > 0 %}
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="5" class="text-end fw-semibold">Total TTC</td>
                                <td colspan="2" class="text-start fw-bold text-primary fs-5">{{ total|number_format(2, ',', ' ') }} €</td>
                            </tr>
                        </tfoot>
                    {% endif %}
                </table>
              </div>
      

              <div class="version-mobile">
                {% for item in items %}
                  <div class="card shadow-sm mb-3">
                    <div class="card-body">
                      <div class="row">
                        <div class="col-4 text-center">
                              <a href="{{ path('app_product_show',{id:item.product.id}) }}">
                                {% if item.product.productImages|length > 0 %}
                                  <img src="{{ vich_uploader_asset(item.product.productImages|first,'imageFile') }}" class="img-fluid rounded" alt="{{ item.product.name }}">
                                {% else %}
                                  <div class="placeholder-img"></div>
                                {% endif %}
                              </a>
                        </div>
                        <div class="col-8">
                                <h6 class="mb-2">{{ item.product.name }}</h6>
                                <small class="text-muted">Réf :{{ item.product.ref }}</small>
                                <div class="mt-2">
                                  <strong>{{ item.product.priceTtc|number_format(2, ',', ' ') }}€</strong>
                                </div>
                                <div class="mt-2">
                                  Quantité :<strong>{{ item.quantity }}</strong>
                                </div>
                                <div class="mt-2 text-primary fw-bold">
                                  Sous-total :{{ (item.product.priceTtc * item.quantity)|number_format(2, ',', ' ') }}€
                                </div>
                                <form method="post"
                                      action="{{ path('app_cart_update', {id: item.product.id}) }}"
                                      class="mt-3">
                                    <div class="input-group">
                                        <input type="number"
                                              name="quantity"
                                              value="{{ item.quantity }}"
                                              min="0"
                                              class="form-control">
                                        <button class="btn btn-primary">↻</button>
                                        <a href="{{ path('app_cart_product_remove', {id: item.product.id}) }}"class="btn btn-outline-danger">🗑️</a>
                                    </div>
                                </form>
                          </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {#---------------------------------------------------#}

        </div>

        <div class="mt-3">
            <a href="{{ path('app_product_list') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Continuer mes achats
            </a>
            <a href="{{ path('app_cart_remove') }}" class="btn btn-outline-danger ms-2">
                <i class="bi bi-trash me-1"></i>Vider le panier
            </a>
        </div>
    </div>

        


    {# ===================== Colonne récapitulatif ===================== #}
    <div class="col-lg-3">
        <div class="card shadow-sm border-0" style="position: sticky; top: 1rem;">
            <div class="card-header bg-primary text-white">
                <strong><i class="bi bi-receipt me-2"></i>Récapitulatif</strong>
            </div>

            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Sous-total TTC</span>
                        <span>{{ total|number_format(2, ',', ' ') }} €</span>
                    </li>
                    <li class="d-flex justify-content-between mb-2">
                        <span class="text-muted">
                            <i class="bi bi-truck me-1"></i>Frais de livraison
                        </span>
                        {% if shippingFee == 0 %}
                            <span class="badge bg-success-subtle text-success-emphasis">Gratuit</span>
                        {% else %}
                            <span>{{ shippingFee|number_format(2, ',', ' ') }} €</span>
                        {% endif %}
                    </li>

                    <li><hr class="my-2"></li>

                    <li class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0">Total</span>
                        <span class="h4 mb-0 text-primary fw-bold">{{ totalWithShipping|number_format(2, ',', ' ') }} €</span>
                    </li>
                </ul>

                {% if shippingFee > 0 %}
                    <p class="text-muted small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Livraison gratuite dès 50,00 € d'achat.
                    </p>
                {% endif %}

                <a href="{{ path('app_order_checkout') }}" class="btn btn-success btn-lg w-100 mt-4">
                    Commander <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>


{% endif %}
{% endblock %}